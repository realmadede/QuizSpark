# QuizSpark Frontend Environment Variables

# ----------------------------------------------------
# Local Development (Defaults)
# ----------------------------------------------------
# By default, Vite proxies /api and /socket.io to localhost:5000 (see vite.config.ts)
# You only need to set these if your backend is running on a different port/URL locally.
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000

# ----------------------------------------------------
# Production Deployment
# ----------------------------------------------------
# When deploying to production, point these to your hosted backend URL.
# VITE_API_URL=https://your-production-backend.com/api
# VITE_SOCKET_URL=https://your-production-backend.com
